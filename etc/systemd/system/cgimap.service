[Unit]
Description=CGImap implementation of the OpenStreetMap editing API
Documentation=https://github.com/zerebubuth/openstreetmap-cgimap
Wants=postgresql.service memcached.service
After=network.target postgresql.service memcached.service
RequiresMountsFor=/opt/opengeofiction

[Service]
Type=forking
User=ogf
Group=www-data
UMask=0002
# All configuration - database, socket, limits, rate limits - is in the env
# file. Options are the command line switches upper-cased with CGIMAP_ prefixed
EnvironmentFile=/opt/opengeofiction/openstreetmap-cgimap/etc/cgimap.env
# /run/cgimap holds the socket Apache proxies to and the pid file, group
# www-data so Apache can connect
RuntimeDirectory=cgimap
RuntimeDirectoryMode=0775
ExecStart=/opt/opengeofiction/openstreetmap-cgimap/bin/openstreetmap-cgimap --daemon --instances 6
ExecReload=/bin/kill -HUP $MAINPID
PIDFile=/run/cgimap/cgimap.pid
Restart=on-failure

[Install]
WantedBy=multi-user.target
