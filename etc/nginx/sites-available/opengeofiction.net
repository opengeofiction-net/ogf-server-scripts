# opengeofiction.net - the site and the API, proxied to Apache. Apache writes
# the site's access log (combined_ms, real client address via mod_remoteip),
# so the proxied blocks do not log: a second copy doubles the volume.

server {
    listen 80;
    listen [::]:80;
    server_name opengeofiction.net;
    access_log off;
    include snippets/ogf-acme.conf;
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name opengeofiction.net;
    include snippets/ogf-tls.conf;
    access_log off;

    location = /server-status {
        allow 127.0.0.1;
        allow ::1;
        allow 10.33.7.0/24;
        deny all;
        include snippets/ogf-proxy.conf;
    }
    location / {
        include snippets/ogf-proxy.conf;
    }
}

# api.ogf is the VPN name, plain HTTP, served as the site
server {
    listen 80;
    listen [::]:80;
    server_name api.ogf;
    access_log off;
    location / {
        include snippets/ogf-proxy.conf;
    }
}
